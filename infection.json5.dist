{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "timeout": 10,
    "threads": "max",
    "logs": {
        "text": "infection.log",
        "summary": "summary.log",
        "stryker": {
            "badge": "/^(main|master)$/"
        }
    },
    "mutators": {
        "@default": true,
        // The additional types' names are plain ASCII, where mb_stripos() and stripos() match alike;
        // mb_stripos() stays so a name with an accent still matches whatever its case.
        "MBString": {
            "ignore": ["Contenir\\Contact\\Type\\AdditionalTypes::search"]
        }
    },
    "staticAnalysisTool": "mago"
}
